{
  "$schema": "vscode://schemas/color-theme",
  "name": "boring light blue",
  "type": "light",
  "include": "./light-base.json",
  "colors": {
    "editor.foreground": "#26211d",
    // "editor.background": "#f7f7f6"
  },
  "semanticHighlighting": false,
  "tokenColors": [
    {
      "name": "Control flow",
      "scope": [
        "keyword.control",
        "keyword.operator.logical",
        "storage.type.function",
        "keyword.function",
        "keyword.type",
        "keyword.var",
        "keyword.struct",
        "storage.type.class.python"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#766657"
      }
    },
    {
      "scope": [
        "keyword.operator",
        // "punctuation"
      ],
      "settings": {
        "foreground": "#766657",
      }
    },
    {
      "scope": [
        "entity.name.function",
        "entity.name.type",
        "support.function.magic.python"
      ],
      "settings": {
        // "foreground": "#3b5468"
      }
    },
    {
      "name": "Class+Function definition",
      "scope": [
        "entity.name.type.class2",
        "entity.function",
        "meta.function-call.generic",
        "entity.name.function.support.go",
        "entity.name.function.decorator.python"
      ],
      "settings": {
        // "foreground": "#1D5786"
      }
    },

    {
      "name": "Strings",
      "scope": ["string", "entity.name.import.go", "punctuation.definition.string"],
      "settings": {
        "foreground": "#103650" // 083758
      }
    },
    {
      "name": "Numbers",
      "scope": ["constant.numeric", "constant.language2", "keyword.other.unit.hexadecimal"],
      "settings": {
        "foreground": "#766657"
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment", "string.quoted.docstring.multi",
        "punctuation.definition.comment",
        "string.quoted.docstring.multi"],
      "settings": {
        "foreground": "#96928c"
      }
    },
    {
      "name": "JSON Key",
      "scope": ["support.type.property-name.json", "punctuation.support.type.property-name"],
      "settings": {
        "foreground": "#24292E"
      }
    }
  ]
}
