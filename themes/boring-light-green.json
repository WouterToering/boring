{
  "$schema": "vscode://schemas/color-theme",
  "name": "boring light green",
  "type": "light",
  "include": "./light-base.json",
  "colors": {
    "editor.background": "#f4f5f7",
    "tab.activeBackground": "#f4f5f7",
    "tab.activeBorder": "#f4f5f7",
    "editor.foreground": "#0C0C0C"
  },
  "semanticHighlighting": false,
  "tokenColors": [
    {
      "name": "Control flow",
      "scope": [
        "keyword.control",
        "keyword.operator.logical",
        // "keyword.operator",
        "storage.type.function",
        "keyword.function",
        "keyword.type",
        "keyword.var",
        "keyword.struct",
        "storage.type.class.python"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "entity.name.type",
        "support.function.magic.python"
      ],
      "settings": {"foreground": "#06576F"}
    },
    {
      "name": "Class+Function definition",
      "scope": [
        "entity.name.type.class2",
        "entity.function",
        "meta.function-call.generic",
        "entity.name.function.support.go",
        "entity.name.function.decorator.python"
      ],
      "settings": {
        "foreground": "#002DAA"
      }
    },

    {
      "name": "Strings",
      "scope": ["string", "entity.name.import.go", "punctuation.definition.string"],
      "settings": {
        "foreground": "#0A7217"
      }
    },
    {
      "name": "Numbers",
      "scope": ["constant.numeric", "constant.language2", "keyword.other.unit.hexadecimal"],
      "settings": {
        "foreground": "#006868"
      }
    },
    {
      "name": "Comments",
      "scope": ["comment", "string.quoted.docstring.multi"],
      "settings": {
        "foreground": "#82858f"
      }
    },
    {
      "name": "JSON Key",
      "scope": ["support.type.property-name.json", "punctuation.support.type.property-name"],
      "settings": {
        "foreground": "#24292E"
      }
    }
  ]
}
